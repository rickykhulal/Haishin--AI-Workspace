# Haishin Backend Configuration (Local Inference)

# Backend server binding (do not expose publicly)
HAISHIN_HOST=127.0.0.1
HAISHIN_PORT=8000

# Local model runtime (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configured default local model (e.g., llama3.2:1b or any model pulled in Ollama)
# If empty or not set, backend auto-detects first available model in Ollama
HAISHIN_DEFAULT_MODEL=

# Inference request timeout in seconds (warm generation vs cold model load)
HAISHIN_INFERENCE_TIMEOUT=120.0

# Allowed frontend origins for CORS (comma-separated)
HAISHIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
